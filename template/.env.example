# Copie para .env.local e preencha.
# Em produção, defina essas variáveis no painel da Vercel (Settings > Environment Variables).

# URL pública do backend (Railway)
VITE_API_URL=https://seu-backend.up.railway.app

# ── Firebase (login com Google) ────────────────────────────────────────────────
# Use as credenciais do projeto Firebase do ecossistema VS (descontoss-vip).
# São chaves públicas de cliente (vão no bundle) — não são segredo.
VITE_FIREBASE_API_KEY=sua_api_key_firebase
VITE_FIREBASE_AUTH_DOMAIN=descontoss-vip.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=descontoss-vip
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# ── Checkout (CTA "Assinar agora" na tela de acesso restrito) ──────────────────
VITE_CHECKOUT_URL=https://checkout.vitissouls.com/
