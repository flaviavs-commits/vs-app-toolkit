# ── Banco de dados (Railway PostgreSQL) ──────────────────────────────────────
# Em produção, use a reference do Postgres do projeto: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host.railway.internal:5432/{{APP_SLUG}}"

# ── JWT (emitido por ESTE backend após o login no VS) ─────────────────────────
# Gere um segredo forte com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="troque_por_um_segredo_muito_longo_e_aleatorio_aqui"
JWT_EXPIRES_IN="7d"

# ── Login VS (Descontos VIP / FCVIP) ──────────────────────────────────────────
# Token de serviço do parceiro — NUNCA exponha no frontend.
PARTNER_AUTH_SERVICE_TOKEN="seu_token_do_parceiro_aqui"
# Login email+senha (parceiro, com X-Service-Token)
PARTNER_AUTH_URL="https://vs-production-c4dd.up.railway.app/api/partner/auth/login/"
# Login com Google (rota pública do VS — valida o id_token Firebase)
PARTNER_AUTH_GOOGLE_URL="https://vs-production-c4dd.up.railway.app/api/auth/firebase/google/"
# Verifica/atualiza membership após o login (usa o access token do usuário)
PARTNER_VERIFY_MEMBERSHIP_URL="https://vs-production-c4dd.up.railway.app/api/auth/verify-membership/"

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL exata do frontend na Vercel (sem barra no final).
# Obrigatória com NODE_ENV=production: sem ela o backend recusa subir.
FRONTEND_URL="https://{{APP_SLUG}}.vercel.app"

# ── Porta (Railway injeta automaticamente) ────────────────────────────────────
PORT={{BACKEND_PORT}}
