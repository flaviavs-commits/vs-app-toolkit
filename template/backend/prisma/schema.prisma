generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuário base do ecossistema VS. Os campos de auth/membership são padrão e o
// módulo de auth depende deles. Adicione abaixo os campos e relations do seu app.
model User {
  id    String @id @default(cuid())
  email String @unique
  nome  String @default("")

  // Id estável da conta no Meu Ecoo (`data.user.id`), gravado a cada login e renovação. Os avisos de
  // conta (POST /api/meuecoo/eventos) acham a pessoa por ele antes do e-mail. Num banco que já tem
  // contas, crie a coluna antes de publicar: prisma/antes-do-deploy/20261112_meuecoo_id.sql.
  meuEcooId String? @unique @map("meuecoo_id")

  // Membership — espelho do status vindo do VS (is_member_active / member_until).
  // FONTE DE VERDADE é o VS (admin / painel manual / Betalabs); aqui é só cache.
  isMember    Boolean   @default(false) @map("is_member")
  memberUntil DateTime? @map("member_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessoesDeRenovacao SessaoDeRenovacao[]

  // ── Campos e relations do {{APP_NAME}} entram aqui ──────────────────────────
  // Ex.: hasOnboarded Boolean @default(false) @map("has_onboarded")
  // Ex.: items        Item[]

  @@map("users")
}

// Refresh tokens da sessão curta. Só o hash SHA-256 do token vai ao banco; o valor puro
// existe apenas na resposta que o entrega. Cada login abre uma família (`familiaId`); cada
// renovação consome um token e emite o seguinte na mesma família. Token já usado que
// reaparece revoga a família inteira (detecção de reuso). A família vale no máximo 30 dias
// desde o login que a abriu (`familiaIniciadaEm`).
model SessaoDeRenovacao {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  familiaId         String    @map("familia_id")
  tokenHash         String    @unique @map("token_hash")
  expiraEm          DateTime  @map("expira_em")
  usadoEm           DateTime? @map("usado_em")
  revogadoEm        DateTime? @map("revogado_em")
  familiaIniciadaEm DateTime  @map("familia_iniciada_em")
  criadoEm          DateTime  @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familiaId])
  @@index([userId])
  @@map("sessoes_de_renovacao")
}
